---
import '../styles/global.css';
import { catalog } from '../lib/catalog';

interface Props {
  title: string;
  description: string;
  nav?: 'browse' | 'sources' | 'guide' | 'review';
  jsonLd?: Record<string, unknown>;
}
const { title, description, nav, jsonLd } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const updated = new Date(catalog.generatedAt).toLocaleDateString('en-US', { dateStyle: 'medium', timeZone: 'UTC' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#0e1015" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="StashPlugins" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
        else if (matchMedia('(prefers-color-scheme: light)').matches) document.documentElement.dataset.theme = 'light';
        if (document.documentElement.dataset.theme === 'light') document.querySelector('meta[name=theme-color]').content = '#f7f7f5';
      } catch {}
    </script>
  </head>
  <body data-base={base}>
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={base}>
          <img src={`${base}favicon.svg`} alt="" width="26" height="26" />
          <span>Stash<em>Plugins</em></span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href={base} class="nav-browse" aria-current={nav === 'browse' ? 'page' : undefined}>Browse</a>
          <a href={`${base}sources/`} aria-current={nav === 'sources' ? 'page' : undefined}>Sources</a>
          <a href={`${base}review/`} aria-current={nav === 'review' ? 'page' : undefined}>Review</a>
          <a href={`${base}guide/`} class="nav-hide" aria-current={nav === 'guide' ? 'page' : undefined}>How to install</a>
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle light/dark theme">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>Data refreshed {updated} from the <a href={catalog.forumUrl}>community source list</a>. Not affiliated with the Stash project.</span>
        <span>Plugins are third-party code. See <a href={`${base}review/`}>community review</a> for how plugins are checked. <a href="https://github.com/SudoMedic/StashPlugins.cc">Source code</a> (MIT).</span>
      </div>
    </footer>
    <div class="toast" role="status" aria-live="polite"></div>
    <script>
      import '../scripts/common';
    </script>
  </body>
</html>
