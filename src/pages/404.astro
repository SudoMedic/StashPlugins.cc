---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Page not found | StashPlugins" description="This page does not exist on StashPlugins.">
  <div class="wrap">
    <section class="notfound">
      <h1>Page not found</h1>
      <p>This address does not match a page on StashPlugins. A plugin page goes away when its source removes the plugin or renames it.</p>
      <div class="links">
        <a class="btn btn-primary" href={base}>Browse plugins</a>
        <a class="btn" href={`${base}sources/`}>Sources</a>
      </div>
    </section>
  </div>
</Base>
