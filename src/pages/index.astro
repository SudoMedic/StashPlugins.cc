---
import Base from '../layouts/Base.astro';
import { catalog, listItems, stats, TYPE_LABELS, type PluginType } from '../lib/catalog';
import { cardHtml } from '../lib/render';
import Cinematic from '../components/Cinematic.astro';

const base = import.meta.env.BASE_URL;
const PAGE = 48;
const canonical = listItems.filter((p) => p.can);
const initial = [...canonical].sort((a, b) => (b.u ?? '').localeCompare(a.u ?? '')).slice(0, PAGE);
const typeOrder: PluginType[] = ['ui', 'theme', 'backend', 'hybrid', 'other'];
const typeCounts = Object.fromEntries(typeOrder.map((t) => [t, canonical.filter((p) => p.t === t).length]));
const sources = catalog.sources.filter((s) => s.count > 0).sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }));
const now = Date.parse(catalog.generatedAt);
---

<Base
  title="StashPlugins | search every Stash plugin and theme"
  description={`Search, sort and install ${stats.unique} community plugins and themes for Stash from ${stats.sources} sources. Copy a one-line install for your Stash instance.`}
  nav="browse"
  cinematic
  jsonLd={{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'StashPlugins', url: Astro.site?.href }}
>
  <div class="cine-hero" data-cine="hero">
    <div class="cine-stage" aria-hidden="true">
      <div class="cine-layer" data-depth="0"><div class="cine-grid"></div></div>
      <div class="cine-layer" data-depth="1"><div class="cine-glow"></div></div>
      <div class="cine-layer" data-depth="2"><span class="cine-ghost">Plugins</span></div>
    </div>
    <section class="hero wrap">
      <h1 data-depth="4" data-cine-intro>Plugins and themes for <em>Stash</em></h1>
      <p data-depth="4" data-cine-intro>A searchable index of {stats.sources} community plugin sources, with install instructions for every plugin.</p>
      <ul class="stats" data-depth="4" data-cine-intro>
        <li><strong>{stats.unique}</strong>plugins &amp; themes</li>
        <li><strong>{stats.sources}</strong>sources</li>
        <li><strong>{stats.authors}</strong>authors</li>
        <li><a href={`${base}review/`}><strong>{stats.verified}</strong>community verified</a></li>
      </ul>
      <form class="search" role="search" onsubmit="return false" data-depth="3" data-cine-intro>
        <span class="cine-corner tl" aria-hidden="true"></span><span class="cine-corner tr" aria-hidden="true"></span><span class="cine-corner bl" aria-hidden="true"></span><span class="cine-corner br" aria-hidden="true"></span>
        <span class="cine-hairline" data-depth="5" aria-hidden="true"></span>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <label for="q" class="sr-only">Search plugins</label>
        <input id="q" type="search" placeholder="Search by name, author, feature…" autocomplete="off" spellcheck="false" />
        <kbd aria-hidden="true">/</kbd>
      </form>
    </section>
  </div>
  <Cinematic />

  <section class="wrap" aria-label="Plugins">
    <div class="toolbar">
      <div class="chips" role="group" aria-label="Filter by type">
        <button type="button" class="chip" data-type="" aria-pressed="true">All <span class="n" data-count="">{canonical.length}</span></button>
        {
          typeOrder.map((t) => (
            <button type="button" class="chip" data-type={t} aria-pressed="false">
              {t === 'other' ? 'Other' : TYPE_LABELS[t]} <span class="n" data-count={t}>{typeCounts[t]}</span>
            </button>
          ))
        }
      </div>
      <div class="toolbar-right">
        <label class="sr-only" for="source">Source</label>
        <select id="source" class="select">
          <option value="">All sources</option>
          {sources.map((s) => <option value={s.slug}>{s.name} ({s.count})</option>)}
        </select>
        <label class="sr-only" for="sort">Sort</label>
        <select id="sort" class="select">
          <option value="relevance">Best match</option>
          <option value="updated" selected>Recently updated</option>
          <option value="created">Newest</option>
          <option value="oldest">Oldest</option>
          <option value="name">Name A–Z</option>
          <option value="author">Author A–Z</option>
        </select>
        <label class="toggle" title="Only show versions approved by community reviewers">
          <input type="checkbox" id="verified" /> Verified only
        </label>
        <label class="toggle" title="Show copies of the same plugin from forks and mirrors">
          <input type="checkbox" id="all" /> Show duplicates
        </label>
      </div>
    </div>
    <p class="result-count" id="count" aria-live="polite">Showing {initial.length} of {canonical.length}</p>
    <div class="grid" id="grid" set:html={initial.map((p) => cardHtml(p, base, { now })).join('')} />
    <div class="empty" id="empty" hidden>
      <p>No plugins match. Try fewer words or clear the filters.</p>
      <button type="button" class="btn" id="reset">Clear filters</button>
    </div>
    <div class="more"><button type="button" class="btn" id="more" hidden={canonical.length <= PAGE}>Show more</button></div>
  </section>

  <dialog class="modal" id="install-dialog" aria-labelledby="install-title">
    <div class="modal-head">
      <div>
        <h2 id="install-title">Install</h2>
        <p id="install-sub"></p>
      </div>
      <button type="button" class="icon-btn" data-close aria-label="Close">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </div>
    <div class="modal-body" id="install-body"></div>
  </dialog>

  <div class="cart" id="cart" hidden>
    <span id="cart-count"></span>
    <button type="button" class="btn btn-sm btn-ghost" id="cart-clear">Clear</button>
    <button type="button" class="btn btn-sm btn-primary" id="cart-install">Install selected</button>
  </div>

  <script>
    import '../scripts/browse';
  </script>
</Base>
